<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══ ЛЕВАЯ ПАНЕЛЬ (MASTER): список ═══ -->
    <LinearLayout
        android:id="@+id/fragment_search_container__left_pane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fragment_search_container__container__details"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.4">

        <TextView
            android:id="@+id/fragment_search_container__text__title"
            style="@style/LargeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp20"
            android:text="@string/fragment_search_container__title" />

        <Button
            android:id="@+id/fragment_search_container__button__open_company_flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp20"
            android:backgroundTint="@color/purple_200"
            android:text="@string/common__open_company_flow" />

        <TextView
            android:id="@+id/fragment_search_container__text__company_flow_result"
            style="@style/LargeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp20"
            android:textSize="20sp"
            tools:text="Has result: false" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_search_container__container__recommend_vacancies"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp20"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- ═══ ПРАВАЯ ПАНЕЛЬ (DETAIL): детали ═══ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_search_container__container__details"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fragment_search_container__left_pane"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>